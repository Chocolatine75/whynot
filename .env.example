# Meta Model API (each member uses their own key)
MODEL_API_KEY=
META_MODEL_BASE_URL=https://api.meta.ai/v1

# Meta Graph API (Ad Library + Marketing API) — long-lived user token
FB_TOKEN=
FB_API_VERSION=v26.0
META_AD_ACCOUNT_ID=          # sandbox ad account for Marketing API tests
PARTNER_AD_ACCOUNT_ID=       # design partner account (read-only unless the owner approves live actions)

# Muse Spark Open on Baseten
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open   # hackathon guide said ...-open-1026; smoke test decides
BASETEN_BASE_URL=https://inference.baseten.co/v1

# Shopify (partner store, custom app) — optional
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=

# Safety (the agency's autopilot)
AUTONOMY_LEVEL=dry_run        # dry_run | propose | autopilot
MAX_DAILY_AD_SPEND_EUR=0      # hard cap; 0 = no live spend
