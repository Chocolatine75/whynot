# Meta Model API (each member uses their own key)
MODEL_API_KEY=
META_MODEL_BASE_URL=https://api.meta.ai/v1

# Meta Graph API (Ad Library + Marketing API) — long-lived user token
FB_TOKEN=
FB_API_VERSION=v26.0
# Marketing API (publishing). Sandbox first: a sandbox ad account never delivers or spends.
META_SANDBOX_AD_ACCOUNT_ID=  # App Dashboard > Marketing API > Tools > Sandbox Ad Account (digits only)
META_SANDBOX_TOKEN=          # token with ads_management for the sandbox account
META_AD_ACCOUNT_ID=          # live ad account (owner's written consent + cap + approval before any live action)
META_ACCESS_TOKEN=           # live token with ads_management
META_PAGE_ID=                # Facebook Page the ads run from
META_APP_ID=                 # the app registered with Meta (only for app-install campaigns)
PARTNER_AD_ACCOUNT_ID=       # design partner account (read-only unless the owner approves live actions)

# Muse Spark Open on Baseten
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026
BASETEN_BASE_URL=https://inference.baseten.co/v1

# Shopify (partner store, custom app) — optional
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=

# Viewer agents: meta (Muse Spark on the Meta API) or baseten (Muse Spark Open)
VIEWER_BACKEND=meta
VIEWER_MODEL=muse-spark-1.3

# Cost ledger (default: outputs/costs.jsonl)
WHYNOT_COST_LOG=

# Recorded model answers (tests and $0 reruns): off | record | replay
WHYNOT_CASSETTE=off
WHYNOT_CASSETTE_DIR=          # default tests/cassettes (committed: never record partner data there)

# Viewer answers are cached so a view is never paid twice: a folder, or off (default data/cache/viewers)
WHYNOT_VIEWER_CACHE=

# Safety (the agency's autopilot)
AUTONOMY_LEVEL=dry_run        # dry_run | propose | autopilot
MAX_DAILY_AD_SPEND_EUR=0      # hard cap; 0 = no live spend

# Voice-over and music for video ads (ElevenLabs; Meta has no text-to-speech model)
ELEVENLABS_API_KEY=
# optional: a voice id from GET /v1/voices (default: a premade multilingual voice)
ELEVENLABS_VOICE_ID=
